{
  "name": "hermes-i18n",
  "version": "0.1.3",
  "description": "CLI tool for extracting, syncing, and translating localization strings",
  "type": "module",
  "bin": {
    "hermes": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node",
    "archive": "bun build src/index.ts --compile --outfile ./output/hermes-i18n",
    "dev": "bun run ./src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/google": "^1.0.0",
    "@ai-sdk/mistral": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "ai": "^4.0.0",
    "commander": "^12.0.0",
    "consola": "^3.2.0",
    "deepl-node": "^1.24.0",
    "fast-xml-parser": "^4.5.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "i18n",
    "localization",
    "translation",
    "cli",
    "ios",
    "android",
    "strings",
    "deepl",
    "ai"
  ],
  "author": "lucaArchidiacono",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaArchidiacono/hermes-i18n.git"
  },
  "homepage": "https://github.com/lucaArchidiacono/hermes-i18n#readme",
  "bugs": {
    "url": "https://github.com/lucaArchidiacono/hermes-i18n/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
